APP_NAME="Newslensbd"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/NewsLens/public

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=newslensbd
DB_USER=root
DB_PASS=

ADMIN_PATH=lens-desk
SESSION_LIFETIME=7200
CSRF_EXPIRY=3600

CACHE_DRIVER=file
UPLOAD_MAX_SIZE=5242880

# Mail / SMTP Configuration (PHPMailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=no-reply@newslensbd.com
MAIL_FROM_NAME="Newslensbd"
MAIL_ENCRYPTION=tls

# Web Push Notifications (minishlink/web-push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@newslensbd.com

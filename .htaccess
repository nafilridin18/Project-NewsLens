<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive directories and files
    RewriteRule ^(\.env|\.git|app|config|storage|database|cron) - [F,L]

    # Forward all other requests to the public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Block access to hidden files (.env, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
